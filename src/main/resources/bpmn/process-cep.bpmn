<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_ProcessCep" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="process-cep" name="Buscar CEP" isExecutable="true">
    <bpmn:startEvent id="Start_CepRecebido" name="CEP recebido">
      <bpmn:outgoing>Flow_Start_BuscarBase</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_BuscarCepBase" name="Buscar CEP na base">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="buscar-cep-base" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_BuscarBase</bpmn:incoming>
      <bpmn:outgoing>Flow_BuscarBase_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CepNaBase" name="CEP existe na base?" default="Flow_Base_Nao">
      <bpmn:incoming>Flow_BuscarBase_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Base_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_Base_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_CepDaBase" name="CEP retornado da base">
      <bpmn:incoming>Flow_Base_Sim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ConsultarViaCep" name="Consultar ViaCEP">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="consultar-viacep" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Base_Nao</bpmn:incoming>
      <bpmn:outgoing>Flow_ViaCep_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CepNoViaCep" name="CEP existe no ViaCEP?" default="Flow_ViaCep_Nao">
      <bpmn:incoming>Flow_ViaCep_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ViaCep_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_ViaCep_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SalvarCep" name="Salvar CEP na base">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="salvar-cep" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ViaCep_Sim</bpmn:incoming>
      <bpmn:outgoing>Flow_Salvar_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_CepSalvo" name="CEP salvo e retornado">
      <bpmn:incoming>Flow_Salvar_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_CepNaoEncontrado" name="CEP não encontrado">
      <bpmn:incoming>Flow_ViaCep_Nao</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_BuscarBase" sourceRef="Start_CepRecebido" targetRef="Task_BuscarCepBase" />
    <bpmn:sequenceFlow id="Flow_BuscarBase_Gateway" sourceRef="Task_BuscarCepBase" targetRef="Gateway_CepNaBase" />
    <bpmn:sequenceFlow id="Flow_Base_Sim" name="Sim" sourceRef="Gateway_CepNaBase" targetRef="End_CepDaBase">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=encontradoNaBase = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Base_Nao" name="Não" sourceRef="Gateway_CepNaBase" targetRef="Task_ConsultarViaCep" />
    <bpmn:sequenceFlow id="Flow_ViaCep_Gateway" sourceRef="Task_ConsultarViaCep" targetRef="Gateway_CepNoViaCep" />
    <bpmn:sequenceFlow id="Flow_ViaCep_Sim" name="Sim" sourceRef="Gateway_CepNoViaCep" targetRef="Task_SalvarCep">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=encontradoNoViaCep = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ViaCep_Nao" name="Não" sourceRef="Gateway_CepNoViaCep" targetRef="End_CepNaoEncontrado" />
    <bpmn:sequenceFlow id="Flow_Salvar_End" sourceRef="Task_SalvarCep" targetRef="End_CepSalvo" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process-cep">
      <bpmndi:BPMNShape id="Start_CepRecebido_di" bpmnElement="Start_CepRecebido">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="137" y="145" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuscarCepBase_di" bpmnElement="Task_BuscarCepBase">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CepNaBase_di" bpmnElement="Gateway_CepNaBase" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="377" y="65" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CepDaBase_di" bpmnElement="End_CepDaBase">
        <dc:Bounds x="502" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="480" y="145" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsultarViaCep_di" bpmnElement="Task_ConsultarViaCep">
        <dc:Bounds x="470" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CepNoViaCep_di" bpmnElement="Gateway_CepNoViaCep" isMarkerVisible="true">
        <dc:Bounds x="625" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="605" y="225" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SalvarCep_di" bpmnElement="Task_SalvarCep">
        <dc:Bounds x="730" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CepSalvo_di" bpmnElement="End_CepSalvo">
        <dc:Bounds x="882" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="860" y="305" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CepNaoEncontrado_di" bpmnElement="End_CepNaoEncontrado">
        <dc:Bounds x="732" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="710" y="445" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_BuscarBase_di" bpmnElement="Flow_Start_BuscarBase">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BuscarBase_Gateway_di" bpmnElement="Flow_BuscarBase_Gateway">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Base_Sim_di" bpmnElement="Flow_Base_Sim">
        <di:waypoint x="445" y="120" />
        <di:waypoint x="502" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="464" y="102" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Base_Nao_di" bpmnElement="Flow_Base_Nao">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="280" />
        <di:waypoint x="470" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="200" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ViaCep_Gateway_di" bpmnElement="Flow_ViaCep_Gateway">
        <di:waypoint x="570" y="280" />
        <di:waypoint x="625" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ViaCep_Sim_di" bpmnElement="Flow_ViaCep_Sim">
        <di:waypoint x="675" y="280" />
        <di:waypoint x="730" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="694" y="262" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ViaCep_Nao_di" bpmnElement="Flow_ViaCep_Nao">
        <di:waypoint x="650" y="305" />
        <di:waypoint x="650" y="420" />
        <di:waypoint x="732" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="658" y="360" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Salvar_End_di" bpmnElement="Flow_Salvar_End">
        <di:waypoint x="830" y="280" />
        <di:waypoint x="882" y="280" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
